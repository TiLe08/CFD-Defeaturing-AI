FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
dimensions      [0 1 -1 0 0 0 0];
internalField   uniform (0 0 0);
boundaryField
{
    inlet       { type fixedValue; value uniform ({{U}} 0 0); }
    outlet      { type zeroGradient; }
    "(topWall|bottomWall)" { type noSlip; }
    "(front|back)" { type empty; }
    "(outer|sides)" { type zeroGradient; }
}

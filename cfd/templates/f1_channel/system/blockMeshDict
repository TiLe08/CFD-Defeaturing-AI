FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      blockMeshDict;
}
// Background mesh: one cubic cell layer in z, slightly larger than the STL in x-y.
convertToMeters 1;

vertices
(
    ({{X0}} {{Y0}} {{Z0}})
    ({{X1}} {{Y0}} {{Z0}})
    ({{X1}} {{Y1}} {{Z0}})
    ({{X0}} {{Y1}} {{Z0}})
    ({{X0}} {{Y0}} {{Z1}})
    ({{X1}} {{Y0}} {{Z1}})
    ({{X1}} {{Y1}} {{Z1}})
    ({{X0}} {{Y1}} {{Z1}})
);

blocks
(
    hex (0 1 2 3 4 5 6 7) ({{NX}} {{NY}} 1) simpleGrading (1 1 1)
);

boundary
(
    front { type patch; faces ((0 3 2 1)); }
    back  { type patch; faces ((4 5 6 7)); }
    outer
    {
        type patch;
        faces ((0 4 7 3) (1 2 6 5) (0 1 5 4) (3 7 6 2));
    }
);

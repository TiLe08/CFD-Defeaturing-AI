FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      nut;
}
dimensions      [0 2 -1 0 0 0 0];
internalField   uniform 0;
boundaryField
{
    inlet       { type calculated; value uniform 0; }
    outlet      { type calculated; value uniform 0; }
    // Spalding: valid for any y+ (the snappy wall cells lie at y+ of about 5-40)
    "(topWall|bottomWall)" { type nutUSpaldingWallFunction; value uniform 0; }
    "(front|back)" { type empty; }
    "(outer|sides)" { type zeroGradient; }
}

FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      k;
}
dimensions      [0 2 -2 0 0 0 0];
internalField   uniform {{K_INF}};
boundaryField
{
    inlet       { type fixedValue; value uniform {{K_INF}}; }
    farfield    { type slip; }
    outlet      { type inletOutlet; inletValue uniform {{K_INF}}; value uniform {{K_INF}}; }
    profile     { type fixedValue; value uniform 1e-12; }
    "(front|back)" { type empty; }
}
